FROM node:22-alpine

# 安裝編譯工具（Alpine 用 apk）
RUN apk add --no-cache python3 make g++

WORKDIR /app

# 複製 package.json 同 package-lock.json
COPY package*.json ./

# 強制由 Source 編譯 better-sqlite3
ENV npm_config_better_sqlite3_build_from_source=true
RUN npm install

# 複製其餘原始碼
COPY . .

EXPOSE 5174

CMD ["node", "src/server.js"]